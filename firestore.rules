rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny all access by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Health check document for connection verification on boot
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedOwner(userId) {
      return isSignedIn()
        && isValidId(userId)
        && request.auth.uid == userId
        && request.auth.token.email_verified == true;
    }

    function isValidProject(data, userId, projectId) {
      return data.keys().hasAll([
          'id',
          'name',
          'clientName',
          'currency',
          'globalPrices',
          'rooms',
          'userId',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'name',
          'clientName',
          'currency',
          'globalPrices',
          'rooms',
          'userId',
          'createdAt',
          'updatedAt'
        ])
        && data.id is string
        && data.id == projectId
        && isValidId(data.id)
        && data.userId is string
        && data.userId == userId
        && data.userId == request.auth.uid
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 200
        && data.clientName is string
        && data.clientName.size() <= 200
        && data.currency is string
        && data.currency.size() >= 1
        && data.currency.size() <= 10
        && data.globalPrices is map
        && data.globalPrices.size() <= 30
        && data.rooms is list
        && data.rooms.size() >= 1
        && data.rooms.size() <= 100
        && data.rooms[0] is map
        && data.createdAt is number
        && data.createdAt > 0
        && data.updatedAt is number
        && data.updatedAt > 0;
    }

    // Projects belonging to an authenticated, verified user
    match /users/{userId}/projects/{projectId} {
      allow get: if isVerifiedOwner(userId)
        && isValidId(projectId)
        && existing().userId == request.auth.uid;

      allow list: if isVerifiedOwner(userId)
        && existing().userId == request.auth.uid;

      allow create: if isVerifiedOwner(userId)
        && isValidId(projectId)
        && isValidProject(incoming(), userId, projectId);

      allow update: if isVerifiedOwner(userId)
        && isValidId(projectId)
        && existing().userId == request.auth.uid
        && isValidProject(incoming(), userId, projectId)
        && incoming().id == existing().id
        && incoming().userId == existing().userId
        && (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt)
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'name',
          'clientName',
          'currency',
          'globalPrices',
          'rooms',
          'updatedAt'
        ]);

      allow delete: if isVerifiedOwner(userId)
        && isValidId(projectId)
        && existing().userId == request.auth.uid;
    }
  }
}
